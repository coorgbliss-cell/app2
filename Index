function fillFromBooking() {
  const bookingId = document.getElementById('ciBooking').value;
  const booking = AppState.bookings.find(b => b.id === bookingId);
  if (booking) {
    document.getElementById('ciName').value = booking.guestName;
    document.getElementById('ciPhone').value = booking.phone;
    document.getElementById('ciEmail').value = booking.email;
    document.getElementById('ciAdults').value = booking.adults;
    document.getElementById('ciKids').value = booking.kids;
    document.getElementById('ciPlan').value = booking.bookingPlan;
    document.getElementById('ciCheckIn').value = booking.checkInDate;
    document.getElementById('ciCheckOut').value = booking.checkOutDate;
    document.getElementById('ciPayment').value = booking.paymentMode === 'Already Paid' ? 'Already Paid' : 'UPI Payment';
    document.getElementById('ciPending').value = booking.pendingAmount || 0;
    booking.roomIds.forEach(rid => {
      const btn = document.getElementById('roomBtn_' + rid);
      if (btn && !btn.classList.contains('cursor-not-allowed')) {
        btn.classList.add('border-blue-500', 'bg-blue-50', 'dark:bg-blue-900/30', 'text-blue-700');
        btn.dataset.selected = 'true';
      }
    });
  }
}

function toggleRoom(roomId) {
  const btn = document.getElementById('roomBtn_' + roomId);
  if (btn.classList.contains('cursor-not-allowed')) return;
  if (btn.dataset.selected === 'true') {
    btn.classList.remove('border-blue-500', 'bg-blue-50', 'dark:bg-blue-900/30', 'text-blue-700');
    btn.dataset.selected = 'false';
  } else {
    btn.classList.add('border-blue-500', 'bg-blue-50', 'dark:bg-blue-900/30', 'text-blue-700');
    btn.dataset.selected = 'true';
  }
}

function handleCheckInSubmit(e) {
  e.preventDefault();
  const bookingId = document.getElementById('ciBooking').value;
  const guestName = document.getElementById('ciName').value;
  const phone = document.getElementById('ciPhone').value;
  const email = document.getElementById('ciEmail').value;
  const adults = parseInt(document.getElementById('ciAdults').value) || 2;
  const kids = parseInt(document.getElementById('ciKids').value) || 0;
  const checkInDate = document.getElementById('ciCheckIn').value;
  const checkOutDate = document.getElementById('ciCheckOut').value;
  const bookingPlan = document.getElementById('ciPlan').value || 'Room Only';
  const idType = document.getElementById('ciIdType').value;
  const idNumber = document.getElementById('ciIdNumber').value;
  const paymentMode = document.getElementById('ciPayment').value;
  const collectedPendingAmount = parseFloat(document.getElementById('ciPending').value) || 0;
  const guestNote = document.getElementById('ciNote').value;
  
  const roomIds = [];
  ROOMS.forEach(room => {
    const btn = document.getElementById('roomBtn_' + room.id);
    if (btn && btn.dataset.selected === 'true') roomIds.push(room.id);
  });
  
  if (!guestName || !phone || roomIds.length === 0) {
    alert('Please fill in all required fields and select at least one room');
    return;
  }
  
  const booking = AppState.bookings.find(b => b.id === bookingId);
  const checkIn = {
    id: generateId(),
    bookingId: bookingId || 'manual-' + Date.now(),
    guestName, phone, email, adults, kids, roomIds,
    checkInDate: normalizeDate(checkInDate),
    checkOutDate: normalizeDate(checkOutDate),
    bookingPlan, bookingType: booking ? booking.bookingType : 'Direct Booking',
    totalAmount: booking ? booking.totalAmount : 0,
    advancePayment: booking ? booking.advancePayment : 0,
    pendingAmount: booking ? booking.pendingAmount : 0,
    paymentMode, status: 'checked-in',
    createdAt: new Date().toISOString(),
    checkedInAt: new Date().toISOString(),
    autoCheckedOut: false,
    idType, idNumber, collectedPendingAmount, guestNote
  };
  
  AppState.checkIns.push(checkIn);
  
  // Update booking status
  if (booking) {
    booking.status = 'checked-in';
  } else {
    AppState.bookings.push({
      id: checkIn.bookingId,
      guestName, phone, email, adults, kids, roomIds,
      checkInDate: normalizeDate(checkInDate),
      checkOutDate: normalizeDate(checkOutDate),
      bookingPlan, bookingType: 'Direct Booking',
      totalAmount: 0, advancePayment: 0, pendingAmount: 0,
      paymentMode, status: 'checked-in',
      createdAt: new Date().toISOString(),
      idType, idNumber, collectedPendingAmount, guestNote: ''
    });
  }
  
  saveState();
  addNotification(`${guestName} checked in successfully`, 'check-in');
  alert(`Check-in successful!\n\nGuest: ${guestName}\nRooms: ${roomIds.map(id => ROOMS.find(r => r.id === id)?.number).join(', ')}`);
  render();
}

