function renderCalendar() {
  const startDate = new Date();
  startDate.setDate(startDate.getDate() - 3);
  const days = [];
  for (let i = 0; i < 14; i++) {
    const d = new Date(startDate);
    d.setDate(d.getDate() + i);
    days.push(d);
  }
  
  const categories = ['Homestay', 'Redbricks Cottage', 'Wooden Cottage'];
  
  return `
    <div class="calendar-scroll">
      <div class="min-w-[800px]">
        <!-- Date headers -->
        <div class="flex border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 sticky top-0">
          <div class="w-24 flex-shrink-0 p-2 font-semibold text-sm border-r border-slate-200 dark:border-slate-700">Room</div>
          ${days.map(d => {
            const isToday = d.toISOString().split('T')[0] === today();
            const isWeekend = d.getDay() === 0 || d.getDay() === 6;
            return `<div class="flex-1 min-w-[60px] p-2 text-center border-r border-slate-200 dark:border-slate-700 ${isToday ? 'bg-blue-100 dark:bg-blue-900/30' : isWeekend ? 'bg-slate-100 dark:bg-slate-800' : ''}">
              <div class="text-xs text-slate-500 dark:text-slate-400">${d.toLocaleDateString('en-US', {weekday:'short'})}</div>
              <div class="text-sm font-semibold ${isToday ? 'text-blue-600 dark:text-blue-400' : ''}">${d.getDate()}</div>
            </div>`;
          }).join('')}
        </div>
        <!-- Room rows -->
        ${categories.map(cat => `
          <div>
            <div class="bg-slate-100 dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700">
              <div class="p-2 font-semibold text-sm text-slate-700 dark:text-slate-300">${cat}</div>
            </div>
            ${ROOMS.filter(r => r.category === cat).map(room => {
              const occupant = AppState.checkIns.find(ci => ci.roomIds.includes(room.id) && !ci.autoCheckedOut);
              return `<div class="flex border-b border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800/50">
                <div class="w-24 flex-shrink-0 p-2 border-r border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800/50">
                  <div class="font-semibold text-sm">${room.number}</div>
                  <div class="text-xs text-slate-500 dark:text-slate-400">${cat.split(' ')[0]}</div>
                </div>
                ${days.map(d => {
                  const dateStr = d.toISOString().split('T')[0];
                  const booking = AppState.bookings.find(b => b.roomIds.includes(room.id) && b.checkInDate <= dateStr && b.checkOutDate > dateStr);
                  const checkIn = AppState.checkIns.find(ci => ci.roomIds.includes(room.id) && ci.checkInDate <= dateStr && ci.checkOutDate > dateStr && !ci.autoCheckedOut);
                  const active = checkIn || booking;
                  const isToday = dateStr === today();
                  if (active) {
                    const isCheckIn = checkIn;
                    const color = isCheckIn ? '#274e13' : (active.bookingType === 'Online' ? '#f59e0b' : active.bookingType === 'Unpaid' ? '#3b82f6' : '#10b981');
                    const nights = Math.ceil((new Date(active.checkOutDate) - new Date(active.checkInDate)) / 86400000);
                    const startDay = Math.max(0, Math.ceil((new Date(active.checkInDate) - startDate) / 86400000));
                    const span = Math.min(14 - startDay, nights);
                    if (startDay < 14 && span > 0) {
                      return `<div class="flex-1 min-w-[60px] p-1 border-r border-slate-200 dark:border-slate-700 relative ${isToday ? 'bg-blue-50 dark:bg-blue-900/10' : ''}">
                        ${startDay === 0 ? `<div class="absolute top-1 bottom-1 left-1 rounded px-2 py-1 text-xs font-semibold text-white truncate shadow-sm" style="background:${color};min-width:56px;max-width:${span*60-8}px;z-index:10;" title="${active.guestName}">${active.guestName}</div>` : ''}
                      </div>`;
                    }
                  }
                  return `<div class="flex-1 min-w-[60px] p-1 border-r border-slate-200 dark:border-slate-700 ${isToday ? 'bg-blue-50 dark:bg-blue-900/10' : ''}"></div>`;
                }).join('')}
              </div>`;
            }).join('')}
          </div>
        `).join('')}
      </div>
    </div>
  `;
}

