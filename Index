function generateMonthOptions(selected) {
  const months = [];
  const now = new Date();
  for (let i = -3; i <= 6; i++) {
    const d = new Date(now.getFullYear(), now.getMonth() + i, 1);
    const val = d.toISOString().slice(0, 7);
    months.push(`<option value="${val}" ${val === selected ? 'selected' : ''}>${d.toLocaleDateString('en-US', {month:'long', year:'numeric'})}</option>`);
  }
  return months.join('');
}

function filterBookings() {
  const search = (document.getElementById('bookingSearch')?.value || '').toLowerCase();
  const month = document.getElementById('bookingMonthFilter')?.value || new Date().toISOString().slice(0, 7);
  const filtered = AppState.bookings
    .filter(b => b.checkInDate.slice(0, 7) === month && b.guestName.toLowerCase().includes(search))
    .sort((a, b) => new Date(a.checkInDate).getTime() - new Date(b.checkInDate).getTime());
  
  const container = document.getElementById('bookingsList');
  if (container) {
    container.innerHTML = filtered.length === 0 ? '<div class="glass-card p-6 text-center"><p class="text-base text-slate-500">No bookings found</p></div>' :
      filtered.map(booking => renderBookingCard(booking)).join('');
  }
}

