              <script>
                              // Coorg Bliss Estate Stay Management - Google Apps Script Backend
// Deploy as Web App with "Execute as: Me" and "Who has access: Anyone"

const SCRIPT_PROPERTIES = PropertiesService.getScriptProperties();

function doGet(e) {
  try {
    const action = e.parameter.action || 'getAll';
    const sheet = e.parameter.sheet || 'Bookings';
    
    if (action === 'health') {
      return ContentService.createTextOutput(JSON.stringify({status: 'ok', timestamp: new Date().toISOString()}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'getAll' || action === 'getAllMonths') {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const sh = ss.getSheetByName(sheet);
      if (!sh) {
        initializeSpreadsheet();
        return ContentService.createTextOutput(JSON.stringify([]))
          .setMimeType(ContentService.MimeType.JSON);
      }
      const data = sh.getDataRange().getValues();
      if (data.length <= 1) {
        return ContentService.createTextOutput(JSON.stringify([]))
          .setMimeType(ContentService.MimeType.JSON);
      }
      const headers = data[0];
      const records = [];
      for (let i = 1; i < data.length; i++) {
        const record = {};
        headers.forEach((h, idx) => { record[h] = data[i][idx]; });
        records.push(record);
      }
      return ContentService.createTextOutput(JSON.stringify(records))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'exportCSV') {
      const month = parseInt(e.parameter.month) || new Date().getMonth() + 1;
      const year = parseInt(e.parameter.year) || new Date().getFullYear();
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      const sh = ss.getSheetByName('Bookings');
      if (!sh) return ContentService.createTextOutput(JSON.stringify({success: false, csv: ''})).setMimeType(ContentService.MimeType.JSON);
      const data = sh.getDataRange().getValues();
      const headers = data[0];
      const filtered = data.slice(1).filter(row => {
        const created = new Date(row[headers.indexOf('createdAt')]);
        return created.getMonth() === month - 1 && created.getFullYear() === year;
      });
      let csv = headers.join(',') + '\n';
      filtered.forEach(row => { csv += row.map(v => '"' + String(v).replace(/"/g, '""') + '"').join(',') + '\n'; });
      return ContentService.createTextOutput(JSON.stringify({success: true, csv: csv})).setMimeType(ContentService.MimeType.JSON);
    }
    
    return ContentService.createTextOutput(JSON.stringify({error: 'Unknown action'}))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({error: err.message}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function doPost(e) {
  try {
    const body = JSON.parse(e.postData.contents);
    const action = body.action;
    const sheet = body.sheet || 'Bookings';
    
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sh = ss.getSheetByName(sheet);
    if (!sh) {
      initializeSpreadsheet();
      sh = ss.getSheetByName(sheet);
    }
    
    if (action === 'create' || action === 'batchCreate') {
      const records = body.records || [body.data];
      const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
      
      records.forEach(record => {
        // Deduplication check
        const compositeKey = (record.guestName || '') + '|' + (record.phone || '') + '|' + (record.checkInDate || '') + '|' + (record.checkOutDate || '');
        const existingData = sh.getDataRange().getValues();
        const keyCol = headers.indexOf('guestName');
        const phoneCol = headers.indexOf('phone');
        const checkInCol = headers.indexOf('checkInDate');
        const checkOutCol = headers.indexOf('checkOutDate');
        
        let isDuplicate = false;
        for (let i = 1; i < existingData.length; i++) {
          const existingKey = (existingData[i][keyCol] || '') + '|' + (existingData[i][phoneCol] || '') + '|' + (existingData[i][checkInCol] || '') + '|' + (existingData[i][checkOutCol] || '');
          if (existingKey === compositeKey) { isDuplicate = true; break; }
        }
        
        if (!isDuplicate) {
          const row = headers.map(h => record[h] !== undefined ? record[h] : '');
          sh.appendRow(row);
        }
      });
      
      return ContentService.createTextOutput(JSON.stringify({success: true, message: 'Created ' + records.length + ' record(s)'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'update') {
      const search = body.search;
      const data = body.data;
      const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
      const allData = sh.getDataRange().getValues();
      
      for (let i = 1; i < allData.length; i++) {
        let match = true;
        for (const key in search) {
          const colIdx = headers.indexOf(key);
          if (colIdx === -1 || allData[i][colIdx] !== search[key]) { match = false; break; }
        }
        if (match) {
          for (const key in data) {
            const colIdx = headers.indexOf(key);
            if (colIdx !== -1) {
              sh.getRange(i + 1, colIdx + 1).setValue(data[key]);
            }
          }
          break;
        }
      }
      
      return ContentService.createTextOutput(JSON.stringify({success: true, message: 'Updated'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'delete') {
      const search = body.search;
      const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
      const allData = sh.getDataRange().getValues();
      
      for (let i = allData.length - 1; i >= 1; i--) {
        let match = true;
        for (const key in search) {
          const colIdx = headers.indexOf(key);
          if (colIdx === -1 || allData[i][colIdx] !== search[key]) { match = false; break; }
        }
        if (match) { sh.deleteRow(i + 1); }
      }
      
      return ContentService.createTextOutput(JSON.stringify({success: true, message: 'Deleted'}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'cleanup') {
      const headers = sh.getRange(1, 1, 1, sh.getLastColumn()).getValues()[0];
      const allData = sh.getDataRange().getValues();
      const seen = new Set();
      let removed = 0;
      const keyCol = headers.indexOf('id');
      const guestCol = headers.indexOf('guestName');
      const phoneCol = headers.indexOf('phone');
      const checkInCol = headers.indexOf('checkInDate');
      const checkOutCol = headers.indexOf('checkOutDate');
      
      for (let i = allData.length - 1; i >= 1; i--) {
        const key = (allData[i][guestCol] || '') + '|' + (allData[i][phoneCol] || '') + '|' + (allData[i][checkInCol] || '') + '|' + (allData[i][checkOutCol] || '');
        if (seen.has(key)) {
          sh.deleteRow(i + 1);
          removed++;
        } else {
          seen.add(key);
        }
      }
      
      return ContentService.createTextOutput(JSON.stringify({success: true, duplicatesRemoved: removed}))
        .setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'createUser') {
      const userSh = ss.getSheetByName('Users');
      if (!userSh) {
        userSh = ss.insertSheet('Users');
        userSh.appendRow(['id','username','password','name','role','pageAccess','canCheckIn','canCreateBooking','canEditBooking','canDeleteBooking','canViewReports','active','createdAt']);
      }
      const data = body.data;
      userSh.appendRow([
        data.id, data.username, data.password, data.name, data.role,
        data.pageAccess || '', data.canCheckIn, data.canCreateBooking,
        data.canEditBooking, data.canDeleteBooking, data.canViewReports,
        data.active, data.createdAt
      ]);
      return ContentService.createTextOutput(JSON.stringify({success: true})).setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'updateUser') {
      const userSh = ss.getSheetByName('Users');
      if (!userSh) return ContentService.createTextOutput(JSON.stringify({error: 'Users sheet not found'})).setMimeType(ContentService.MimeType.JSON);
      const headers = userSh.getRange(1, 1, 1, userSh.getLastColumn()).getValues()[0];
      const allData = userSh.getDataRange().getValues();
      const search = body.search;
      const data = body.data;
      
      for (let i = 1; i < allData.length; i++) {
        if (allData[i][headers.indexOf('id')] === search.id) {
          for (const key in data) {
            const colIdx = headers.indexOf(key);
            if (colIdx !== -1) userSh.getRange(i + 1, colIdx + 1).setValue(data[key]);
          }
          break;
        }
      }
      return ContentService.createTextOutput(JSON.stringify({success: true})).setMimeType(ContentService.MimeType.JSON);
    }
    
    if (action === 'deleteUser') {
      const userSh = ss.getSheetByName('Users');
      if (!userSh) return ContentService.createTextOutput(JSON.stringify({error: 'Users sheet not found'})).setMimeType(ContentService.MimeType.JSON);
      const headers = userSh.getRange(1, 1, 1, userSh.getLastColumn()).getValues()[0];
      const allData = userSh.getDataRange().getValues();
      const search = body.search;
      
      for (let i = allData.length - 1; i >= 1; i--) {
        if (allData[i][headers.indexOf('id')] === search.id) {
          userSh.deleteRow(i + 1);
          break;
        }
      }
      return ContentService.createTextOutput(JSON.stringify({success: true})).setMimeType(ContentService.MimeType.JSON);
    }
    
    return ContentService.createTextOutput(JSON.stringify({error: 'Unknown action: ' + action}))
      .setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({error: err.message}))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

