<script>
// ==================== DATA & CONFIG ====================
const ROOMS = [
  {id:"r101",number:"101",category:"Homestay",floor:"Ground Floor",price:2500},
  {id:"r102",number:"102",category:"Homestay",floor:"Ground Floor",price:2500},
  {id:"r103",number:"103",category:"Homestay",floor:"Ground Floor",price:2500},
  {id:"r104",number:"104",category:"Homestay",floor:"First Floor",price:3000},
  {id:"r105",number:"105",category:"Homestay",floor:"First Floor",price:3000},
  {id:"r106",number:"106",category:"Redbricks Cottage",floor:"Ground Floor",price:4000},
  {id:"r107",number:"107",category:"Redbricks Cottage",floor:"Ground Floor",price:4000},
  {id:"r108",number:"108",category:"Wooden Cottage",floor:"Ground Floor",price:5000},
  {id:"r109",number:"109",category:"Wooden Cottage",floor:"Ground Floor",price:5000}
];

const DEFAULT_APPS_SCRIPT_URL = "https://script.google.com/macros/s/AKfycbyNK46hdKdJuyc7hnH2Y-5qUVwWWobgNZSXtlMHxRx3dqy6UVJEa5IYq0X0kR0HEpC6/exec";

const DEFAULT_USERS = [
  {id:"u1",username:"Ashwin",password:"ASH@888",name:"Ashwin",role:"admin",pageAccess:["dashboard","checkin","bookings","reports","settings"],permissions:{canCheckIn:true,canCreateBooking:true,canEditBooking:true,canDeleteBooking:true,canViewReports:true},active:true,createdAt:new Date().toISOString()}
];

// ==================== STATE MANAGEMENT ====================
const AppState = {
  bookings: [],
  checkIns: [],
  notifications: [],
  users: [],
  viewMode: 'desktop',
  theme: 'light',
  isAuthenticated: false,
  currentUser: null,
  currentPage: 'dashboard',
  mobileMenuOpen: false,
  showNotifications: false,
  syncStatus: 'idle',
  syncMessage: '',
  lastSync: null,
  appsScriptUrl: '',
  deferredInstallPrompt: null
};

// Load from localStorage
function loadState() {
  try {
    const saved = localStorage.getItem('cb_bookings');
    if (saved) AppState.bookings = JSON.parse(saved);
    const savedCI = localStorage.getItem('cb_checkins');
    if (savedCI) AppState.checkIns = JSON.parse(savedCI);
    const savedNotif = localStorage.getItem('cb_notifications');
    if (savedNotif) AppState.notifications = JSON.parse(savedNotif);
    const savedUsers = localStorage.getItem('cb_users');
    if (savedUsers) AppState.users = JSON.parse(savedUsers);
    else AppState.users = [...DEFAULT_USERS];
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme) AppState.theme = savedTheme;
    const savedAuth = localStorage.getItem('cb_auth');
    if (savedAuth === 'true') AppState.isAuthenticated = true;
    const savedUser = localStorage.getItem('cb_current_user');
    if (savedUser) AppState.currentUser = JSON.parse(savedUser);
    const savedUrl = localStorage.getItem('appsScriptUrl');
    // FIX: Only use saved URL if it exists, otherwise use default
    AppState.appsScriptUrl = savedUrl || DEFAULT_APPS_SCRIPT_URL;
  } catch(e) {
    console.error('Load state error:', e);
    AppState.users = [...DEFAULT_USERS];
    AppState.appsScriptUrl = DEFAULT_APPS_SCRIPT_URL;
  }
}

function saveState() {
  try {
    localStorage.setItem('cb_bookings', JSON.stringify(AppState.bookings));
    localStorage.setItem('cb_checkins', JSON.stringify(AppState.checkIns));
    localStorage.setItem('cb_notifications', JSON.stringify(AppState.notifications));
    localStorage.setItem('cb_users', JSON.stringify(AppState.users));
    localStorage.setItem('theme', AppState.theme);
    localStorage.setItem('cb_auth', String(AppState.isAuthenticated));
    if (AppState.currentUser) localStorage.setItem('cb_current_user', JSON.stringify(AppState.currentUser));
    localStorage.setItem('appsScriptUrl', AppState.appsScriptUrl);
  } catch(e) { console.error('Save state error:', e); }
}

// ==================== UTILITIES ====================
function generateId() { return 'id_' + Date.now() + '_' + Math.random().toString(36).substr(2,9); }
function normalizeDate(d) { if (!d) return ''; try { return new Date(d).toISOString().split('T')[0]; } catch { return d; } }
function today() { return new Date().toISOString().split('T')[0]; }
function getApiUrl(action) {
  const base = AppState.appsScriptUrl;
  const sep = base.includes('?') ? '&' : '?';
  return action ? `${base}${sep}action=${action}` : base;
}

function playNotificationSound() {
  try {
    const audio = new AudioContext();
    const o1 = audio.createOscillator(); const g1 = audio.createGain();
    o1.connect(g1); g1.connect(audio.destination);
    o1.frequency.value = 880; o1.type = 'sine';
    g1.gain.setValueAtTime(0.3, audio.currentTime);
    g1.gain.exponentialRampToValueAtTime(0.01, audio.currentTime + 0.15);
    o1.start(audio.currentTime); o1.stop(audio.currentTime + 0.15);
    const o2 = audio.createOscillator(); const g2 = audio.createGain();
    o2.connect(g2); g2.connect(audio.destination);
    o2.frequency.value = 660; o2.type = 'sine';
    g2.gain.setValueAtTime(0.3, audio.currentTime + 0.15);
    g2.gain.exponentialRampToValueAtTime(0.01, audio.currentTime + 0.3);
    o2.start(audio.currentTime + 0.15); o2.stop(audio.currentTime + 0.3);
  } catch(e) {}
}

function addNotification(message, type='info') {
  const notif = { id: generateId(), message, type, timestamp: new Date().toISOString(), read: false };
  AppState.notifications.unshift(notif);
  saveState();
  playNotificationSound();
  render();
}

// ==================== API FUNCTIONS ====================
async function fetchFromAppsScript() {
  AppState.syncStatus = 'syncing';
  AppState.syncMessage = 'Syncing...';
  render();
  try {
    const response = await fetch(getApiUrl('getAllMonths'));
    if (response.ok) {
      const data = await response.json();
      if (Array.isArray(data)) {
        const newBookings = data.map(item => {
          const roomIds = (item.roomIds || '').split(',').map(r => r.trim()).filter(r => r);
          return {
            id: item.id,
            guestName: item.guestName || '',
            phone: String(item.phone || ''),
            email: item.email || '',
            adults: parseInt(item.adults) || 2,
            kids: parseInt(item.kids) || 0,
            roomIds: roomIds.length ? roomIds : [],
            checkInDate: normalizeDate(item.checkInDate),
            checkOutDate: normalizeDate(item.checkOutDate),
            bookingPlan: item.bookingPlan || 'Room Only',
            bookingType: item.bookingType || 'Direct Booking',
            totalAmount: parseFloat(item.totalAmount) || 0,
            advancePayment: parseFloat(item.advancePayment) || 0,
            pendingAmount: parseFloat(item.pendingAmount) || 0,
            paymentMode: item.paymentMode || 'UPI Payment',
            status: item.status || 'booked',
            createdAt: item.createdAt || new Date().toISOString(),
            idType: item.idType || '',
            idNumber: item.idNumber || '',
            collectedPendingAmount: parseFloat(item.collectedPendingAmount) || 0,
            guestNote: item.guestNote || ''
          };
        });
        // Merge: keep existing, add new
        const existingIds = new Set(AppState.bookings.map(b => b.id));
        newBookings.forEach(nb => { if (!existingIds.has(nb.id)) AppState.bookings.push(nb); });
        
        // Sync check-ins from bookings with status checked-in
        AppState.bookings.forEach(b => {
          if (b.status === 'checked-in') {
            const exists = AppState.checkIns.find(ci => ci.bookingId === b.id);
            if (!exists) {
              AppState.checkIns.push({
                id: 'ci-' + b.id,
                bookingId: b.id,
                guestName: b.guestName,
                phone: b.phone,
                email: b.email,
                adults: b.adults,
                kids: b.kids,
                roomIds: b.roomIds,
                checkInDate: b.checkInDate,
                checkOutDate: b.checkOutDate,
                bookingPlan: b.bookingPlan,
                bookingType: b.bookingType,
                totalAmount: b.totalAmount,
                advancePayment: b.advancePayment,
                pendingAmount: b.pendingAmount,
                paymentMode: b.paymentMode,
                status: 'checked-in',
                createdAt: b.createdAt,
                checkedInAt: b.createdAt,
                autoCheckedOut: false,
                idType: b.idType,
                idNumber: b.idNumber,
                collectedPendingAmount: b.collectedPendingAmount
              });
            }
          }
        });
        
        AppState.lastSync = new Date().toISOString();
        AppState.syncStatus = 'success';
        AppState.syncMessage = `Fetched ${data.length} records`;
      }
    }
  } catch(e) {
    console.log('Fetch failed:', e);
    AppState.syncStatus = 'error';
    AppState.syncMessage = 'Fetch failed: ' + e.message;
  }
  saveState();
  render();
}

async function syncToAppsScript() {
  AppState.syncStatus = 'syncing';
  AppState.syncMessage = 'Syncing all data...';
  render();
  try {
    if (AppState.bookings.length === 0) {
      AppState.syncStatus = 'success';
      AppState.syncMessage = 'No bookings to sync';
      render();
      return;
    }
    const records = AppState.bookings.map(b => ({
      id: b.id,
      guestName: b.guestName,
      phone: b.phone,
      email: b.email,
      adults: b.adults,
      kids: b.kids,
      roomIds: b.roomIds.join(','),
      checkInDate: normalizeDate(b.checkInDate),
      checkOutDate: normalizeDate(b.checkOutDate),
      bookingPlan: b.bookingPlan,
      bookingType: b.bookingType,
      totalAmount: b.totalAmount,
      advancePayment: b.advancePayment,
      pendingAmount: b.pendingAmount,
      paymentMode: b.paymentMode,
      status: b.status,
      createdAt: normalizeDate(b.createdAt),
      idType: b.idType || '',
      idNumber: b.idNumber || '',
      collectedPendingAmount: b.collectedPendingAmount || 0,
      guestNote: b.guestNote || ''
    }));
    await fetch(getApiUrl(), {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify({ action: 'batchCreate', sheet: 'Bookings', records })
    });
    AppState.lastSync = new Date().toISOString();
    AppState.syncStatus = 'success';
    AppState.syncMessage = `Synced ${AppState.bookings.length} booking(s)`;
  } catch(e) {
    AppState.syncStatus = 'error';
    AppState.syncMessage = 'Sync failed: ' + e.message;
  }
  saveState();
  render();
}

async function cleanupDuplicates() {
  try {
    await fetch(getApiUrl(), {
      method: 'POST',
      mode: 'no-cors',
      headers: { 'Content-Type': 'text/plain' },
      body: JSON.stringify({ action: 'cleanup', sheet: 'Bookings' })
    });
    addNotification('Duplicate cleanup completed', 'info');
    return { success: true, duplicatesRemoved: 0, message: 'Cleanup completed' };
  } catch(e) {
    addNotification('Cleanup failed: ' + e.message, 'info');
    return { success: false, duplicatesRemoved: 0, message: 'Cleanup failed' };
  }
}

// ==================== BUSINESS LOGIC ====================
function getTodayCheckIns() {
  const t = today();
  return AppState.checkIns.filter(ci => ci.checkInDate === t && !ci.autoCheckedOut);
}

function getTodayCheckOuts() {
  const t = today();
  return AppState.checkIns.filter(ci => ci.checkOutDate === t && ci.autoCheckedOut);
}

function getActiveCheckIns() {
  // FIX: Only show check-ins that are NOT auto-checked-out
  return AppState.checkIns.filter(ci => !ci.autoCheckedOut);
}

function getAvailableRooms() {
  const t = today();
  const occupied = new Set();
  AppState.checkIns.forEach(ci => {
    if (ci.checkInDate <= t && ci.checkOutDate > t && !ci.autoCheckedOut) {
      ci.roomIds.forEach(rid => occupied.add(rid));
    }
  });
  AppState.bookings.forEach(b => {
    if (b.checkInDate <= t && b.checkOutDate > t && b.status === 'booked') {
      b.roomIds.forEach(rid => occupied.add(rid));
    }
  });
  return ROOMS.filter(r => !occupied.has(r.id));
}

function isRoomAvailable(roomId, checkIn, checkOut, excludeBookingId) {
  const ci = AppState.checkIns.find(ci => ci.roomIds.includes(roomId) && ci.checkInDate < checkOut && ci.checkOutDate > checkIn && !ci.autoCheckedOut);
  if (ci) return false;
  const b = AppState.bookings.find(b => b.id !== excludeBookingId && b.roomIds.includes(roomId) && b.checkInDate < checkOut && b.checkOutDate > checkIn && b.status === 'booked');
  return !b;
}

function canCheckIn(booking) {
  const t = today();
  return booking.checkInDate === t && booking.status === 'booked';
}

function getSalesReport(month) {
  const [year, mon] = month.split('-').map(Number);
  const monthBookings = AppState.bookings.filter(b => {
    const d = new Date(b.createdAt);
    return d.getMonth() === mon - 1 && d.getFullYear() === year;
  });
  const checkedIn = monthBookings.filter(b => b.status === 'checked-in' || b.status === 'checked-out');
  const totalSales = checkedIn.reduce((s, b) => s + b.totalAmount, 0);
  const totalCollected = checkedIn.reduce((s, b) => s + b.advancePayment, 0);
  const totalPendingCollected = checkedIn.reduce((s, b) => s + (b.collectedPendingAmount || 0), 0);
  return { totalSales, totalCollected, totalPendingCollected, bookings: monthBookings };
}

// Auto checkout at 11:30 AM
function checkAutoCheckout() {
  const now = new Date();
  const h = now.getHours(), m = now.getMinutes();
  const t = today();
  if (h > 11 || (h === 11 && m >= 30)) {
    AppState.checkIns.forEach(ci => {
      if (ci.checkOutDate === t && !ci.autoCheckedOut) {
        ci.autoCheckedOut = true;
      }
    });
    saveState();
  }
}

// ==================== AUTH ====================
function login(username, password) {
  const user = AppState.users.find(u => u.username === username && u.password === password && u.active);
  if (user) {
    AppState.isAuthenticated = true;
    AppState.currentUser = user;
    saveState();
    render();
    return true;
  }
  return false;
}

function logout() {
  AppState.isAuthenticated = false;
  AppState.currentUser = null;
  localStorage.removeItem('cb_auth');
  localStorage.removeItem('cb_current_user');
  render();
}

function hasPageAccess(page) {
  if (!AppState.currentUser) return false;
  if (AppState.currentUser.role === 'admin') return true;
  return AppState.currentUser.pageAccess && AppState.currentUser.pageAccess.includes(page);
}

function hasPermission(perm) {
  if (!AppState.currentUser) return false;
  if (AppState.currentUser.role === 'admin') return true;
  return AppState.currentUser.permissions && AppState.currentUser.permissions[perm];
}

