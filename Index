function editBooking(id) {
  const booking = AppState.bookings.find(b => b.id === id);
  if (!booking) return;
  // Simple edit via prompt
  const newStatus = prompt('Update status (booked/checked-in/checked-out/cancelled):', booking.status);
  if (newStatus && ['booked','checked-in','checked-out','cancelled'].includes(newStatus)) {
    booking.status = newStatus;
    saveState();
    render();
  }
}

function deleteBooking(id) {
  if (!confirm('Are you sure you want to delete this booking?')) return;
